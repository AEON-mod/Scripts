#!/usr/bin/env bash
# set-cursor — change cursor theme + size on Hyprland
#
# Usage:
#   set-cursor                             # interactive picker (fzf)
#   set-cursor <ThemeName>                 # set theme, then prompt for size
#   set-cursor --list                      # list available themes
#   set-cursor --uninstall                 # pick and uninstall a theme (fzf)
#   set-cursor --uninstall <ThemeName>     # uninstall a specific theme

VARS="$HOME/.config/hypr/variables.conf"
VARS_LUA="$HOME/.config/hypr/variables.lua"
ICONS="$HOME/.local/share/icons"

list_themes() {
    for d in "$ICONS"/*/; do
        [[ -d "$d/cursors" ]] || continue
        basename "$d"
    done | sort
}

if [[ "${1:-}" == "--list" ]]; then
    echo "Available cursor themes:"
    list_themes | sed 's/^/  /'
    exit 0
fi

# ── Uninstall ─────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--uninstall" ]]; then
    if [[ -n "${2:-}" ]]; then
        THEME="$2"
    elif command -v fzf &>/dev/null; then
        THEME=$(list_themes | fzf --prompt="Uninstall cursor theme: " --height=15 --reverse)
        [[ -z "$THEME" ]] && exit 0
    else
        echo "Available themes:"
        list_themes | nl -ba | sed 's/^/  /'
        echo -n "Pick number to uninstall: "
        read -r num
        THEME=$(list_themes | sed -n "${num}p")
        [[ -z "$THEME" ]] && exit 0
    fi
    
    DIR="$ICONS/$THEME"
    [[ -d "$DIR" ]] || { echo "Error: theme '$THEME' not found in $ICONS"; exit 1; }
    
    echo -n "Are you sure you want to permanently delete '$THEME'? [y/N] "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$DIR"
        echo "✓ Uninstalled $THEME"
    else
        echo "Aborted."
    fi
    exit 0
fi


# ── Pick theme ────────────────────────────────────────────────────────────────
if [[ -z "${1:-}" ]]; then
    if command -v fzf &>/dev/null; then
        THEME=$(list_themes | fzf --prompt="Cursor theme: " --height=15 --reverse)
        [[ -z "$THEME" ]] && { echo "No theme selected."; exit 1; }
    else
        echo "Available themes:"
        list_themes | nl -ba | sed 's/^/  /'
        echo -n "Pick number: "
        read -r num
        THEME=$(list_themes | sed -n "${num}p")
        [[ -z "$THEME" ]] && { echo "No theme selected."; exit 1; }
    fi
else
    THEME="$1"
fi

[[ -z "$THEME" ]] && { echo "No theme selected."; exit 1; }

# Validate theme exists
[[ -d "$ICONS/$THEME/cursors" ]] || { echo "Error: theme '$THEME' not found in $ICONS"; exit 1; }

# ── Pick size ─────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
    if command -v fzf &>/dev/null; then
        SIZES="16\n24\n32\n40\n48\n56\n64\n96"
        SIZE=$(echo -e "$SIZES" | fzf --prompt="Cursor size: " --height=10 --reverse)
    else
        echo -n "Cursor size (default 24): "
        read -r SIZE
    fi
fi

if [[ -z "${SIZE:-}" ]]; then
    # Try reading from variables.conf first, then variables.lua, then default
    SIZE=$(grep -E '^\$cursorSize\s*=' "$VARS" 2>/dev/null | grep -oE '[0-9]+' | head -1)
    if [[ -z "$SIZE" && -f "$VARS_LUA" ]]; then
        SIZE=$(grep -E '^\s*cursorSize\s*=' "$VARS_LUA" 2>/dev/null | grep -oE '[0-9]+' | head -1)
    fi
    SIZE="${SIZE:-24}"
fi

# Ensure SIZE is purely numeric to prevent config corruption from typos
if ! [[ "$SIZE" =~ ^[0-9]+$ ]]; then
    echo "⚠  Invalid size '$SIZE' provided. Defaulting to 24."
    SIZE="24"
fi

echo "→ Setting cursor: $THEME  size: $SIZE"

# ── 1. Update variables.conf and variables.lua ────────────────────────────────
if [[ -f "$VARS" ]]; then
    sed -i "s|^\\\$cursorTheme = .*|\$cursorTheme = $THEME|" "$VARS"
    sed -i "s|^\\\$cursorSize = .*|\$cursorSize = $SIZE|"    "$VARS"
fi
if [[ -f "$VARS_LUA" ]]; then
    sed -i -E "s|^([ \t]*cursorTheme[ \t]*=[ \t]*).*|\1\"$THEME\",|" "$VARS_LUA"
    sed -i -E "s|^([ \t]*cursorSize[ \t]*=[ \t]*).*|\1$SIZE,|" "$VARS_LUA"
fi

# ── 2. Apply live (Hyprland + XCursor env) ───────────────────────────────────
if command -v hyprctl &>/dev/null; then
    if ! hyprctl setcursor "$THEME" "$SIZE" &>/dev/null; then
        echo "⚠  hyprctl setcursor failed — is Hyprland running?"
    fi
    # Update the env vars live so newly launched apps also see the new theme/size
    hyprctl setenv XCURSOR_THEME "$THEME" &>/dev/null
    hyprctl setenv XCURSOR_SIZE  "$SIZE"  &>/dev/null
fi

# Helper: set or append a key=value in an ini-style file
_set_ini_key() {
    local file="$1" key="$2" value="$3"
    if grep -q "^${key}=" "$file" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$file"
    else
        echo "${key}=${value}" >> "$file"
    fi
}

# ── 3. Sync GTK2 ─────────────────────────────────────────────────────────────
GTK2="$HOME/.gtkrc-2.0"
if [[ -f "$GTK2" ]]; then
    _set_ini_key "$GTK2" "gtk-cursor-theme-name" "\"$THEME\""
    _set_ini_key "$GTK2" "gtk-cursor-theme-size" "$SIZE"
fi

# ── 4. Sync GTK3 ─────────────────────────────────────────────────────────────
GTK3="$HOME/.config/gtk-3.0/settings.ini"
if [[ -f "$GTK3" ]]; then
    _set_ini_key "$GTK3" "gtk-cursor-theme-name" "$THEME"
    _set_ini_key "$GTK3" "gtk-cursor-theme-size" "$SIZE"
fi

# ── 5. Sync GTK4 ─────────────────────────────────────────────────────────────
GTK4="$HOME/.config/gtk-4.0/settings.ini"
if [[ -f "$GTK4" ]]; then
    _set_ini_key "$GTK4" "gtk-cursor-theme-name" "$THEME"
    _set_ini_key "$GTK4" "gtk-cursor-theme-size" "$SIZE"
fi

# ── 6. Sync gsettings (GNOME/GTK portal) ─────────────────────────────────────
if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface cursor-theme "$THEME" &>/dev/null
    gsettings set org.gnome.desktop.interface cursor-size  "$SIZE"  &>/dev/null
fi

# ── 7. Sync XDG cursor (for X11 apps via xrdb) ───────────────────────────────
XCURSOR_DIR="$HOME/.icons/default"
mkdir -p "$XCURSOR_DIR"
cat > "$XCURSOR_DIR/index.theme" <<EOF
[Icon Theme]
Inherits=$THEME
EOF

# Reload xrdb so X11 apps pick up the new cursor immediately
if command -v xrdb &>/dev/null; then
    {
        echo "Xcursor.theme: $THEME"
        echo "Xcursor.size:  $SIZE"
    } | xrdb -merge &>/dev/null
fi

echo "✓ Done! Theme: $THEME  Size: $SIZE"

# Reload Hyprland so the cursor change propagates to all running apps immediately
echo "  Reloading Hyprland..."
hyprctl reload &>/dev/null && echo "✓ Reloaded — changes are live across all apps!"
